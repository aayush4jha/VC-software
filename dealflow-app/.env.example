# Copy to .env.local for local dev. In production, set these in
# Vercel → Project → Settings → Environment Variables.

# ---------- Supabase ----------
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side admin actions (invites, service-role reads). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- App URLs ----------
# Used for invite links (api/invite-user) and booking links
# (api/calendar/create-booking-link). Both fall back to
# http://localhost:3000, so if they are unset in production the emails
# will contain localhost links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Google OAuth (Gmail + Calendar + Drive) ----------
# console.cloud.google.com/apis/credentials
# The redirect URI below must ALSO be listed under the OAuth client's
# "Authorized redirect URIs", once per environment.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ---------- Outbound email (invites) ----------
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ---------- Gemini (deck analysis) ----------
GEMINI_API_KEY=
GEMINI_API_KEY_BACKUP=

# ---------- The morning cron job ----------
# Any long random string you invent — it is a shared password, not an account.
# Generate one with:  openssl rand -hex 32
#
# Vercel Cron sends it back as "Authorization: Bearer $CRON_SECRET" on every
# call to /api/cron/daily (scheduled in vercel.json). With this unset the route
# refuses EVERY request with a 503, so the debt reminders and the personal
# pitch-deck reports never go out. An endpoint that emails borrowers must not
# be left open, so there is no fallback.
#
# Set it in Vercel → Project → Settings → Environment Variables (Production),
# then redeploy. Locally it is only needed to call the job by hand.
CRON_SECRET=

# ---------- WhatsApp bot (send decks from your phone) ----------
# developers.facebook.com → your app → WhatsApp → API Setup.
# Every one of the first four is required before the bot answers at all.
# Permanent token from a System User, not the 24-hour test token.
WHATSAPP_ACCESS_TOKEN=
# "Phone number ID" on the API Setup page — not the phone number itself.
WHATSAPP_PHONE_NUMBER_ID=
# App Settings → Basic → App Secret. Signs the webhook; a request whose
# X-Hub-Signature-256 does not match it is rejected.
WHATSAPP_APP_SECRET=
# A string you invent. Paste the same value into the webhook's
# "Verify token" field when subscribing, or verification fails.
WHATSAPP_VERIFY_TOKEN=
# Optional. The number shown in the app so people know where to message.
WHATSAPP_DISPLAY_NUMBER=
# Optional. Graph API version; defaults to v23.0.
WHATSAPP_GRAPH_VERSION=
